rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user has an active subscription
    function isSubscribed() {
      // DEVELOPMENT/PILOT MODE: Allow all authenticated users to bypass subscription check.
      // PRODUCTION MODE: Once your backend/Razorpay is ready, delete 'return true;' and uncomment the line below.
      return true;
      // return request.auth.token.isSubscribed == true;
    }

    // Rules for User Profiles
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Rules for Customers
    match /customers/{customerId} {
      // Agents can only read customers assigned to them
      allow read: if isAuthenticated() && resource.data.assignedAgentId == request.auth.uid;
      // Agents can only create/update if they are assigned
      allow create, update: if isAuthenticated() 
        && request.resource.data.assignedAgentId == request.auth.uid
        && isSubscribed();
      allow delete: if false; // Prevent accidental deletion of financial records
    }

    // Rules for Batches (Used by ImportScreen)
    match /batches/{batchId} {
      allow read: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // Rules for Interactions (used in CollectionUpdateScreen)
    match /interactions/{interactionId} {
      // Allow read for authenticated users (prevents index/query filtering blocks)
      allow read: if isAuthenticated();
      // Only allow creation/update if it genuinely belongs to the agent writing it
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.agentId;
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.agentId;
    }

    // Rules for Notifications (used in CollectionUpdateScreen)
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.recipientId;
      allow create: if isAuthenticated(); // Allowed to create notes triggering notifications
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.recipientId;
    }

    // Rules for Visits and Follow-ups
    match /visits/{visitId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.agentId && isSubscribed();
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.agentId && isSubscribed();
    }
    
    match /followups/{followupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.agentId && isSubscribed();
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.agentId && isSubscribed();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}