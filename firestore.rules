rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSubscribed() {
      // PRODUCTION MODE: Replace with token check when ready
      return true;
      // return request.auth.token.isSubscribed == true;
    }

    // Core Multi-Tenancy validation function
    function isSameAgency(documentAgencyId) {
      // Allow if the document is unassigned, OR if the user token matches the document
      return documentAgencyId == 'UNASSIGNED' ||
        (request.auth.token.agencyId != null && request.auth.token.agencyId == documentAgencyId);
    }

    // =========================================================
    // Rules for User Profiles (Strict Multi-Tenancy)
    // =========================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        // A user can read their own profile
        request.auth.uid == userId || 
        // OR an Admin/Manager can read profiles within their SAME agency
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['agency_manager', 'admin'] &&
          isSameAgency(resource.data.get('agencyId', 'UNASSIGNED'))
        )
      );
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Rules for Customers
    match /customers/{customerId} {
      allow read: if isAuthenticated() && (resource.data.assignedAgentId == request.auth.uid || isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')));
      allow create: if isAuthenticated() 
                    && (request.resource.data.assignedAgentId == request.auth.uid || isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED')))
                    && isSubscribed();
      allow update: if isAuthenticated() 
                    && (resource.data.assignedAgentId == request.auth.uid || isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')))
                    && (request.resource.data.assignedAgentId == request.auth.uid || isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED')))
                    && isSubscribed();
      allow delete: if false; 
    }

    // Rules for Batches
    match /batches/{batchId} {
      allow read: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')));
      allow create, update, delete: if isAuthenticated() 
                                    && (request.resource.data.createdBy == request.auth.uid || isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED')));
    }

    // Rules for Interactions
    match /interactions/{interactionId} {
      allow read: if isAuthenticated() && (resource.data.agentId == request.auth.uid || isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')));
      allow create, update, delete: if isAuthenticated() 
                                    && (request.resource.data.agentId == request.auth.uid || isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED')));
    }

    // Rules for Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')));
      allow create, update, delete: if isAuthenticated(); 
    }

    // Rules for Visits
    match /visits/{visitId} {
      allow read: if isAuthenticated() && (resource.data.agentId == request.auth.uid || isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')));
      allow create, update, delete: if isAuthenticated() 
                                    && (request.resource.data.agentId == request.auth.uid || isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED'))) 
                                    && isSubscribed();
    }
    
    // Rules for Follow-ups
    match /followups/{followupId} {
      allow read: if isAuthenticated() && (resource.data.agentId == request.auth.uid || isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')));
      allow create, update, delete: if isAuthenticated() 
                                    && (request.resource.data.agentId == request.auth.uid || isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED'))) 
                                    && isSubscribed();
    }

    // Rules for Cash Deposits
    match /cashDeposits/{depositId} {
      allow create: if isAuthenticated() && request.resource.data.agentId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.agentId == request.auth.uid || isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')));
      allow update: if isAuthenticated() && request.auth.token.role == 'agency_manager' && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED'));
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}