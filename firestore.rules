rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSubscribed() {
      // PRODUCTION MODE: Replace with token check when ready
      return true;
    }

    // Core Multi-Tenancy validation function (Safely checks token)
    function isSameAgency(documentAgencyId) {
      // Allow if the document belongs to the user's own UID (manager or independent agent)
      return documentAgencyId == 'UNASSIGNED' ||
             documentAgencyId == request.auth.uid ||
             ('agencyId' in request.auth.token && request.auth.token.agencyId == documentAgencyId);
    }

    // Helper to safely check if the user has Manager/Admin privileges without crashing
    function hasManagerRole() {
      return ('role' in request.auth.token && request.auth.token.role in ['agency_manager', 'independent_agent', 'admin']) ||
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'agent') in ['agency_manager', 'independent_agent', 'admin']);
    }

    // =========================================================
    // Rules for User Profiles (Strict Multi-Tenancy)
    // =========================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        // A user can read their own profile
        request.auth.uid == userId || 
        // OR an Admin/Manager/Independent Agent can read profiles within their SAME agency
        (hasManagerRole() && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')))
      );
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Rules for Customers
    match /customers/{customerId} {
      allow read: if isAuthenticated() && (resource.data.assignedAgentId == request.auth.uid || isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')));
      allow create: if isAuthenticated() 
                    && (request.resource.data.assignedAgentId == request.auth.uid || isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED')))
                    && isSubscribed();
      allow update: if isAuthenticated() 
                    && (resource.data.assignedAgentId == request.auth.uid || isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')))
                    && (request.resource.data.assignedAgentId == request.auth.uid || isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED')))
                    && isSubscribed();
      allow delete: if false; 
    }

    // Rules for Batches
    match /batches/{batchId} {
      allow read: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')));
      allow create: if isAuthenticated() && (request.resource.data.createdBy == request.auth.uid || isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED')));
      allow update: if isAuthenticated() && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')) && isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED'));
      allow delete: if isAuthenticated() && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED'));
    }

    // Rules for Interactions
    match /interactions/{interactionId} {
      allow read: if isAuthenticated() && (resource.data.agentId == request.auth.uid || isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')));
      allow create: if isAuthenticated() && (request.resource.data.agentId == request.auth.uid || isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED')));
      allow update: if isAuthenticated() && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')) && isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED'));
      allow delete: if isAuthenticated() && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED'));
    }

    // Rules for Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')));
      allow create, update, delete: if isAuthenticated(); 
    }

    // Rules for Visits
    match /visits/{visitId} {
      allow read: if isAuthenticated() && (resource.data.agentId == request.auth.uid || isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')));
      allow create: if isAuthenticated() && (request.resource.data.agentId == request.auth.uid || isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED'))) && isSubscribed();
      allow update: if isAuthenticated() && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')) && isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED')) && isSubscribed();
      allow delete: if isAuthenticated() && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')) && isSubscribed();
    }
    
    // Rules for Follow-ups
    match /followups/{followupId} {
      allow read: if isAuthenticated() && (resource.data.agentId == request.auth.uid || isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')));
      allow create: if isAuthenticated() && (request.resource.data.agentId == request.auth.uid || isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED'))) && isSubscribed();
      allow update: if isAuthenticated() && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')) && isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED')) && isSubscribed();
      allow delete: if isAuthenticated() && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')) && isSubscribed();
    }

    // Rules for Cash Deposits
    match /cashDeposits/{depositId} {
      allow create: if isAuthenticated() && request.resource.data.agentId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.agentId == request.auth.uid || isSameAgency(resource.data.get('agencyId', 'UNASSIGNED')));
      allow update: if isAuthenticated() && hasManagerRole() && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED'));
    }

    // =========================================================
    // NEW: Rules for Campaigns and Templates (Independent Agent Auth Model)
    // =========================================================
    match /campaigns/{campaignId} {
      allow read: if isAuthenticated() && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED'));
      
      // Separated create, update, and delete to prevent "request.resource is null" crashes
      allow create: if isAuthenticated() 
        && isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED'))
        && hasManagerRole();
        
      allow update: if isAuthenticated() 
        && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED'))
        && isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED'))
        && hasManagerRole();
        
      allow delete: if isAuthenticated() 
        && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED'))
        && hasManagerRole();
    }

    match /templates/{templateId} {
      allow read: if isAuthenticated() && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED'));
      
      allow create: if isAuthenticated() 
        && isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED'))
        && hasManagerRole();
        
      allow update: if isAuthenticated() 
        && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED'))
        && isSameAgency(request.resource.data.get('agencyId', 'UNASSIGNED'))
        && hasManagerRole();
        
      allow delete: if isAuthenticated() 
        && isSameAgency(resource.data.get('agencyId', 'UNASSIGNED'))
        && hasManagerRole();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}